{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "data.js", "use": "@vercel/static" },
    { "src": "views.js", "use": "@vercel/static" },
    { "src": "main.js", "use": "@vercel/static" },
    { "src": "vendor/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*\\.[^/]+)$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
